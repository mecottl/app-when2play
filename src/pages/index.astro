---
import Layout from '../layouts/Layout.astro';
---
<Layout title="when2 play · Inicio">
  <div class="card">
    <div class="tab-toggle" role="group" aria-label="Unirme o crear sala">
      <button type="button" id="tab-join-btn" class="tab-btn active">Unirme</button>
      <button type="button" id="tab-create-btn" class="tab-btn">Crear</button>
    </div>

    <h2 id="form-title">Únete a una sala</h2>
    <p class="hint" id="form-hint">Ingresa el código que te compartieron para entrar al calendario de tu equipo.</p>

    <div class="form-group">
      <label for="main-input" id="main-label">Código de sala</label>
      <input type="text" id="main-input" placeholder="Ej. 67823" maxlength="10" autocomplete="off" inputmode="numeric" />
    </div>

    <button id="submit-btn">Entrar</button>
    <p id="error-msg" class="hint" style="color: var(--color-danger); display:none;"></p>
  </div>
</Layout>

<script>
  type Sala = { id: string; codigo: string; nombre: string };
  type Mode = 'join' | 'create';

  function goToSala(sala: Sala) {
    localStorage.setItem('sala', JSON.stringify(sala));
    localStorage.removeItem('participant');
    window.location.href = `/sala/${sala.codigo}`;
  }

  const tabJoinBtn = document.getElementById('tab-join-btn') as HTMLButtonElement;
  const tabCreateBtn = document.getElementById('tab-create-btn') as HTMLButtonElement;
  const formTitle = document.getElementById('form-title')!;
  const formHint = document.getElementById('form-hint')!;
  const mainLabel = document.getElementById('main-label')!;
  const mainInput = document.getElementById('main-input') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;

  let mode: Mode = 'join';

  function setMode(next: Mode) {
    mode = next;
    tabJoinBtn.classList.toggle('active', next === 'join');
    tabCreateBtn.classList.toggle('active', next === 'create');

    errorMsg.style.display = 'none';
    mainInput.value = '';

    if (next === 'join') {
      formTitle.textContent = 'Únete a una sala';
      formHint.textContent = 'Ingresa el código que te compartieron para entrar al calendario de tu equipo.';
      mainLabel.textContent = 'Código de sala';
      mainInput.placeholder = 'Ej. 67823';
      mainInput.maxLength = 10;
      mainInput.inputMode = 'numeric';
      submitBtn.textContent = 'Entrar';
    } else {
      formTitle.textContent = 'Crea una sala nueva';
      formHint.textContent = 'Crea un espacio nuevo para tu equipo. Te daremos un código para compartir.';
      mainLabel.textContent = 'Nombre de la sala';
      mainInput.placeholder = 'Ej. Cabo Verde Entrenamientos';
      mainInput.maxLength = 60;
      mainInput.inputMode = 'text';
      submitBtn.textContent = 'Crear sala';
    }

    mainInput.focus();
  }

  tabJoinBtn.addEventListener('click', () => setMode('join'));
  tabCreateBtn.addEventListener('click', () => setMode('create'));

  async function doJoin() {
    const codigo = mainInput.value.trim();
    errorMsg.style.display = 'none';
    if (!codigo) {
      errorMsg.textContent = 'Escribe un código.';
      errorMsg.style.display = 'block';
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = 'Buscando...';
    try {
      const res = await fetch(`/api/salas?codigo=${encodeURIComponent(codigo)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'No se encontró la sala');
      goToSala(data);
    } catch (err: any) {
      errorMsg.textContent = err.message || 'Ocurrió un error, intenta de nuevo.';
      errorMsg.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Entrar';
    }
  }

  async function doCreate() {
    const nombre = mainInput.value.trim();
    errorMsg.style.display = 'none';

    if (!nombre) {
      errorMsg.textContent = 'Escribe un nombre para la sala.';
      errorMsg.style.display = 'block';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creando...';

    try {
      const res = await fetch('/api/salas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'No se pudo crear la sala');
      goToSala(data);
    } catch (err: any) {
      errorMsg.textContent = err.message || 'Ocurrió un error, intenta de nuevo.';
      errorMsg.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear sala';
    }
  }

  submitBtn.addEventListener('click', () => {
    if (mode === 'join') doJoin();
    else doCreate();
  });

  mainInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      if (mode === 'join') doJoin();
      else doCreate();
    }
  });
</script>