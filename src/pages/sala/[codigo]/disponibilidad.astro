---
import Layout from '../../../layouts/Layout.astro';
import { getSalaByCodigo } from '../../../lib/db';

const { codigo } = Astro.params;
const sala = codigo ? await getSalaByCodigo(codigo) : null;

if (!sala) {
  return Astro.redirect('/?error=sala-no-encontrada');
}

const DIAS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const HORAS = Array.from({ length: 14 }, (_, i) => i + 8);
---
<Layout title={`${sala.nombre} · Mi disponibilidad`} sala={sala}>
  <div id="page-data" data-codigo={sala.codigo} hidden></div>

  <div class="card">
    <h2 id="greeting">Mi disponibilidad</h2>
    <p class="hint">
      Toca una casilla para marcarla. En el celular, activa "Marcar varias" si quieres
      arrastrar el dedo para marcar varias casillas seguidas. No olvides guardar al terminar.
    </p>
    <button id="switch-user-btn" class="link-muted">¿No eres tú? Cambiar de jugador</button>
  </div>

  <div class="mode-toggle" role="group" aria-label="Modo de interacción con el calendario">
    <button type="button" id="mode-scroll-btn" class="mode-btn active">Desplazar</button>
    <button type="button" id="mode-paint-btn" class="mode-btn">Marcar varias</button>
  </div>

  <div class="grid-wrapper">
    <div class="avail-grid" id="avail-grid">
      <div class="cell-label"></div>
      {DIAS.map((dia) => <div class="day-label">{dia}</div>)}
      {HORAS.map((hora) => (
        <>
          <div class="cell-label">{hora}:00</div>
          {DIAS.map((_, dayIndex) => (
            <div class="avail-cell" data-day={dayIndex} data-hour={hora}></div>
          ))}
        </>
      ))}
    </div>
  </div>

  <div class="actions-bar">
    <button id="save-btn">Guardar disponibilidad</button>
  </div>
  <p class="save-status" id="save-status"></p>
</Layout>

<script>
  type Participant = { id: string; name: string; numero: number | null };

  const pageData = document.getElementById('page-data')!;
  const codigo = pageData.dataset.codigo!;

  const raw = localStorage.getItem('participant');
  if (!raw) {
    window.location.href = `/sala/${codigo}`;
  }
  const participant: Participant | null = raw ? JSON.parse(raw) : null;

  const greeting = document.getElementById('greeting')!;
  if (participant) {
    greeting.textContent = `Hola, ${participant.name}`;
  }

  document.getElementById('switch-user-btn')?.addEventListener('click', () => {
    localStorage.removeItem('participant');
    window.location.href = `/sala/${codigo}`;
  });

  const grid = document.getElementById('avail-grid')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const saveStatus = document.getElementById('save-status')!;
  const scrollBtn = document.getElementById('mode-scroll-btn') as HTMLButtonElement;
  const paintBtn = document.getElementById('mode-paint-btn') as HTMLButtonElement;

  let selected = new Set<string>();
  let touchMode: 'scroll' | 'paint' = 'scroll';

  function setTouchMode(mode: 'scroll' | 'paint') {
    touchMode = mode;
    grid.classList.toggle('paint-mode', mode === 'paint');
    grid.style.touchAction = mode === 'paint' ? 'none' : 'pan-x pan-y';
    scrollBtn.classList.toggle('active', mode === 'scroll');
    paintBtn.classList.toggle('active', mode === 'paint');
  }

  scrollBtn.addEventListener('click', () => setTouchMode('scroll'));
  paintBtn.addEventListener('click', () => setTouchMode('paint'));

  let mouseDragging = false;
  let dragMode: 'add' | 'remove' = 'add';
  let startCell: HTMLElement | null = null;
  let startX = 0;
  let startY = 0;
  let touchMoved = false;
  const MOVE_THRESHOLD = 10;

  function slotId(day: string, hour: string) {
    return `${day}-${hour}`;
  }

  function paintCell(cell: HTMLElement, on: boolean) {
    cell.classList.toggle('selected', on);
  }

  function loadAvailability() {
    if (!participant) return;
    fetch(`/api/disponibilidad?participantId=${participant.id}`)
      .then((res) => res.json())
      .then((data) => {
        selected = new Set<string>(data.slots || []);
        grid.querySelectorAll<HTMLElement>('.avail-cell').forEach((cell) => {
          const id = slotId(cell.dataset.day!, cell.dataset.hour!);
          paintCell(cell, selected.has(id));
        });
      })
      .catch(() => {
        saveStatus.textContent = 'No se pudo cargar tu disponibilidad guardada.';
      });
  }

  function toggleCell(cell: HTMLElement, forceMode: 'add' | 'remove') {
    const id = slotId(cell.dataset.day!, cell.dataset.hour!);
    if (forceMode === 'add') {
      selected.add(id);
      paintCell(cell, true);
    } else {
      selected.delete(id);
      paintCell(cell, false);
    }
  }

  grid.addEventListener('pointerdown', (e) => {
    const target = (e.target as HTMLElement).closest('.avail-cell') as HTMLElement | null;
    if (!target) return;

    if (e.pointerType === 'mouse') {
      mouseDragging = true;
      const id = slotId(target.dataset.day!, target.dataset.hour!);
      dragMode = selected.has(id) ? 'remove' : 'add';
      toggleCell(target, dragMode);
      grid.setPointerCapture(e.pointerId);
      e.preventDefault();
      return;
    }

    startCell = target;
    startX = e.clientX;
    startY = e.clientY;
    touchMoved = false;

    if (touchMode === 'paint') {
      const id = slotId(target.dataset.day!, target.dataset.hour!);
      dragMode = selected.has(id) ? 'remove' : 'add';
      toggleCell(target, dragMode);
      grid.setPointerCapture(e.pointerId);
      e.preventDefault();
    }
  });

  grid.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'mouse') {
      if (!mouseDragging) return;
      const el = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
      const target = el?.closest('.avail-cell') as HTMLElement | null;
      if (target) toggleCell(target, dragMode);
      return;
    }

    if (touchMode === 'paint') {
      e.preventDefault();
      const el = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
      const target = el?.closest('.avail-cell') as HTMLElement | null;
      if (target) toggleCell(target, dragMode);
      return;
    }

    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (Math.hypot(dx, dy) > MOVE_THRESHOLD) {
      touchMoved = true;
    }
  });

  function endTouch() {
    if (touchMode === 'scroll' && !touchMoved && startCell) {
      const id = slotId(startCell.dataset.day!, startCell.dataset.hour!);
      toggleCell(startCell, selected.has(id) ? 'remove' : 'add');
    }
    startCell = null;
    touchMoved = false;
  }

  grid.addEventListener('pointerup', (e) => {
    if (e.pointerType === 'mouse') {
      mouseDragging = false;
      return;
    }
    endTouch();
  });

  grid.addEventListener('pointercancel', (e) => {
    if (e.pointerType === 'mouse') {
      mouseDragging = false;
      return;
    }
    startCell = null;
    touchMoved = false;
  });

  window.addEventListener('pointerup', () => {
    mouseDragging = false;
  });

  saveBtn.addEventListener('click', async () => {
    if (!participant) return;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Guardando...';
    saveStatus.style.color = 'var(--color-text-muted)';
    try {
      const res = await fetch('/api/disponibilidad', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ participantId: participant.id, slots: Array.from(selected) }),
      });
      if (!res.ok) throw new Error('Error al guardar');
      saveStatus.style.color = 'var(--color-success)';
      saveStatus.textContent = 'Disponibilidad guardada';
      setTimeout(() => (saveStatus.textContent = ''), 3000);
    } catch {
      saveStatus.style.color = 'var(--color-danger)';
      saveStatus.textContent = 'No se pudo guardar. Intenta de nuevo.';
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Guardar disponibilidad';
    }
  });

  setTouchMode('scroll');
  if (participant) loadAvailability();
</script>